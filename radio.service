[Unit]
Description=Browser-controlled mpv radio

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/radio/radio.py --config %h/.config/radio/streams.json --runtime-dir %t/radio
Restart=on-failure
RestartSec=3
RuntimeDirectory=radio
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
